<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="SpenVolt" />
    <style name="SpenVolt.Text" />

    <style name="SpenVolt.Text.Title">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="SpenVolt.Text.CardTitle">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/dark_blue</item>
    </style>

    <style name="SpenVolt.Text.Label">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/slate_500</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <style name="SpenVolt.Text.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/gray_500</item>
    </style>

    <style name="SpenVolt.Text.Body">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/dark_blue</item>
    </style>

    <style name="SpenVolt.Text.Stat">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/dark_blue</item>
    </style>

    <style name="SpenVolt.Text.Stat.Yellow">
        <item name="android:textColor">@color/yellow</item>
    </style>

    <style name="SpenVolt.Text.Error">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/red_600</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="SpenVolt.Input">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/slate_400</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="SpenVolt.Button.Green" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/green_button</item>
        <item name="android:textColor">@color/dark_blue</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="SpenVolt.Button.Dark" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/dark_blue</item>
        <item name="android:textColor">@color/yellow</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="SpenVolt.Button.Dark.Small">
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <style name="SpenVolt.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/white</item>
        <item name="strokeColor">@color/slate_300</item>
        <item name="android:textColor">@color/dark_blue</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="SpenVolt.Button.Danger" parent="SpenVolt.Button.Outline">
        <item name="strokeColor">@color/status_exceeded</item>
        <item name="android:textColor">@color/red_600</item>
    </style>

    <style name="SpenVolt.Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
        <item name="android:elevation">2dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="SpenVolt.Card.Dark">
        <item name="android:background">@drawable/bg_card_dark</item>
    </style>

    <style name="SpenVolt.AccentBar">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">4dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/bg_accent_bar</item>
    </style>

    <style name="SpenVolt.DrawerItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>
</resources>
