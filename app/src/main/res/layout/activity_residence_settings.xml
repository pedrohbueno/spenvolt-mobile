<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/SpenVolt.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configurações" />

        <View style="@style/SpenVolt.AccentBar" />

        <TextView
            android:id="@+id/txtResidenceName"
            style="@style/SpenVolt.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Carregando…"
            android:textSize="13sp" />

        <LinearLayout
            style="@style/SpenVolt.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <TextView
                style="@style/SpenVolt.Text.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dados da residência" />

            <include layout="@layout/view_residence_fields" />

            <TextView
                android:id="@+id/txtStatus"
                style="@style/SpenVolt.Text.Error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/SpenVolt.Button.Green"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Salvar alterações" />
        </LinearLayout>

        <LinearLayout
            style="@style/SpenVolt.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <TextView
                style="@style/SpenVolt.Text.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Membros" />

            <TextView
                android:id="@+id/txtMembersEmpty"
                style="@style/SpenVolt.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Nenhum membro nesta residência."
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/membersContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />
        </LinearLayout>

        <TextView
            style="@style/SpenVolt.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Excluir a residência remove também seus dispositivos e membros."
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDelete"
            style="@style/SpenVolt.Button.Danger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Excluir residência" />
    </LinearLayout>
</ScrollView>
